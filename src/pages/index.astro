---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Gallery from '../components/Gallery.astro'
import Contact from '../components/Contact.astro'
---
<Base>
  <Header />
  <main>
    <Hero />

    <section id="destaques" class="container mx-auto py-16">
      <div class="text-center">
        <h2 class="section-heading">Destaques da casa</h2>
        <p class="section-subtitle">Descubra os clássicos que mais encantam nossos clientes: maciez, sabor e acabamento impecável em cada fornada.</p>
      </div>
      <div class="feature-grid mt-10">
        <div class="feature-card">
          <h3>Croissants</h3>
          <p>Folhados, amanteigados e crocantes, feitos com massa maturada e manteiga premium.</p>
        </div>
        <div class="feature-card">
          <h3>Éclairs</h3>
          <p>Recheios clássicos e sazonais, com acabamento delicado e cobertura brilhante.</p>
        </div>
        <div class="feature-card">
          <h3>Tartes</h3>
          <p>Frutas frescas e confeitaria fina em bases crocantes e cremosas.</p>
        </div>
      </div>
    </section>

    <section id="sobre" class="container mx-auto py-16">
      <div class="text-center">
        <h2 class="section-heading">Sobre a Béni Soit-Il</h2>
      </div>
      <div class="max-w-3xl mx-auto rounded-[32px] border border-[var(--color-border)] bg-[var(--color-surface)] p-10 shadow-[0_18px_40px_rgba(17,17,17,0.05)]">
        <p class="section-subtitle">Somos uma padaria inspirada na tradição francesa, trabalhando com ingredientes selecionados e técnicas artesanais para criar produtos que valorizam cada detalhe.</p>
      </div>
    </section>

    <Gallery />

    <Contact />
  </main>

  <footer class="border-t mt-12 py-6 text-center text-sm text-gray-600">
    <div class="container mx-auto">
      <div class="mb-1">© Béni Soit-Il</div>
      <div>Seg–Sáb: 07:45–18:00 • WhatsApp: +55 43 99178-8577 • <span class="font-nectar">Chef Camila</span></div>
      <div class="text-xs text-gray-500 mt-2">Avenida Europa, 105 — Londrina, PR</div>
    </div>
  </footer>
</Base>
