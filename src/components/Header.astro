---
const siteBase = import.meta.env.SITE ? new URL(import.meta.env.SITE).pathname.replace(/\/$/, '') : '';
const adminLoginUrl = `${siteBase}/admin/supabase-login`;
---
<header class="container mx-auto flex flex-col gap-4 py-6 md:flex-row md:items-center md:justify-between">
  <div class="site-brand">Béni Soit-Il</div>
  <nav class="site-nav">
    <a href="#destaques">Destaques</a>
    <a href="#sobre">Sobre</a>
    <a href="#galeria">Galeria</a>
    <a href="#contato">Contato</a>
    <a href={adminLoginUrl} class="btn-primary">Login ADM</a>
  </nav>
</header>
