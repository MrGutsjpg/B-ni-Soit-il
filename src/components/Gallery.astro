---
const siteBase = import.meta.env.SITE ? new URL(import.meta.env.SITE).pathname.replace(/\/$/, '') : '';
const placeholderImage = `${siteBase}/images/placeholder.svg`;
---
<section id="galeria" class="container mx-auto py-16">
  <div class="text-center">
    <h2 class="section-heading">Galeria</h2>
    <p class="section-subtitle">Um vislumbre dos nossos produtos e da apresentação cuidadosa que entregamos em cada encomenda.</p>
  </div>
  <div class="gallery-grid mt-10">
    <img src={placeholderImage} alt="produto" />
    <img src={placeholderImage} alt="produto" />
    <img src={placeholderImage} alt="produto" />
    <img src={placeholderImage} alt="produto" />
  </div>
</section>
