---
const { title, description, price, image, id } = Astro.props;
const whatsappProductUrl = `https://wa.me/5543991788577?text=${encodeURIComponent(`Olá, quero encomendar o produto ${title} por R$ ${price}.`)}`;
---
<article class="card-border p-4 rounded-md bg-white">
  <img src={image} alt={title} class="w-full h-40 object-cover rounded-md mb-4" />
  <h3 class="font-serif text-lg text-primary">{title}</h3>
  <p class="text-gray-600 mt-2">{description}</p>
  <div class="mt-4 flex items-center justify-between">
    <span class="font-semibold">R$ {price}</span>
    <a class="btn-primary" href={whatsappProductUrl} target="_blank" rel="noopener noreferrer">Encomendar</a>
  </div>
</article>
