# Supabase public client keys (used in the browser)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# (Optional) Service role key for server-side actions (keep secret)
# SUPABASE_SERVICE_KEY=your-service-role-key

# Simple admin token to protect server endpoints (choose uma string segura)
ADMIN_TOKEN=uma-string-segura-aqui
